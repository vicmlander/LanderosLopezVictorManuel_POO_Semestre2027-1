import java.util.Random;

public class GeneradorContrasenas {
//=========ATRIBUTOs============
     int longitud;

    // ==========Constructores=============
    public GeneradorContrasenas(int longitud) {
        this.longitud = longitud;
    }
    public GeneradorContrasenas() {
    
    }
//============METODOS==================
    // Método para generar la contraseña
    public String generar() {

        String caracteres = "abcdefghijklmnopqrstuvwxyz"
                + "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                + "0123456789"+"@#!$%^&*";

        Random random = new Random();//creacion de un objeto random

        // Usamos StringBuilder para construir la contraseña
        StringBuilder contrasena = new StringBuilder();

        for (int i = 0; i < longitud; i++) {//bucle para la longitud que se indique

            int posicion = random.nextInt(caracteres.length());//Genera un número aleatorio entre 0 y caracteres.length() - 1. Ese número será el índice de un carácter dentro de la cadena caracteres.

            contrasena.append(caracteres.charAt(posicion));// lo añade al StringBuilder.
        }

        return contrasena.toString();//convierte el StringBuilder a String y lo devuelve.
    }
} 